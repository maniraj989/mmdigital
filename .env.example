# Resend API Configuration for Vercel
# Add these environment variables in your Vercel Project Settings > Environment Variables

# Your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destination email where lead notifications will be received (e.g. mmdigitagarage@gmail.com)
CONTACT_TO_EMAIL=mmdigitagarage@gmail.com

# Verified sender address on your domain (e.g. notifications@mmdigitalgarage.tech or contact@yourverifieddomain.com)
CONTACT_FROM_EMAIL="MM Digital Garage <notifications@mmdigitalgarage.tech>"
